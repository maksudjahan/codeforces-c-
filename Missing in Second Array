class Solution {
  public:
    vector<int> findMissing(vector<int>& a, vector<int>& b) {
        // code here
        int i,j;
        int N=100005;
        int arr[N]={0};
        int ab[N]={0};
        int ac[N]={0};
        for(i=0;i<a.size();i++){
            arr[a[i]]++;
        }
        for(i=0;i<b.size();i++){
            ab[b[i]]++;
        }
        vector<int>ans;
    for(i=0;i<a.size();i++){
        if(ab[a[i]]==0) {
            ans.push_back(a[i]);

    }
    }
    return ans;
    }
};
