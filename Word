#include<bits/stdc++.h>
using namespace std;
int main()
{
    int i=0;
    string s;
    cin>>s;
    int l=s.size();
    int up=0,lo=0;
    for(i=0;i<l;i++){
        if(s[i]>='a'&&s[i]<='z'){
            lo++;
        }
        if(s[i]>='A'&&s[i]<='Z'){
            up++;
        }
    }
    if (up>lo){
        for(i=0;i<l;i++){
            if(s[i]>='a'&&s[i]<='z'){
                s[i]=s[i]-32;
            }
        }
    }
else if (up<=lo){
        for(i=0;i<l;i++){
            if(s[i]>='A'&&s[i]<='Z'){
                s[i]=s[i]+32;
            }
        }
    }
    cout<<s;
cout<<endl;
    return 0;
    }
