#include<bits/stdc++.h>
using namespace std;
int main(){
int n;
cin>>n;
int arr[n],cpy[n];
for(int i=0;i<n;i++){
    cin>>arr[i];
    cpy[i]=arr[i];
}
sort(cpy,cpy+n);
int x=cpy[0];
int y=cpy[n-1];
int l1,l2;
for(int i=0;i<n;i++){
    if(arr[i]==x){
        l1=i;
    }}
for(int i=0;i<n;i++){
    if(arr[i]==y){
        l2=i;
        break;
    }
}
if(l2>l1) cout<<l2-l1+n-2<<endl;
else cout<<l2-l1+n-1<<endl;
return 0;
}
