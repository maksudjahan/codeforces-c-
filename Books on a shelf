#include<bits/stdc++.h>
using namespace std;
int main(){
int t;
cin>>t;
while(t--){
    int n,i;
    cin>>n;
    int arr[n],ans[n];
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    sort(arr,arr+n);
    int j=0;
    int k=0;
    for(i=0;i<n;i++){
            if(i%2==0){
                    ans[n-1-j]=arr[i];
                    j++;
            }
            else {
                    ans[k]=arr[i];
                    k++;
}
    }
    int count=n;
for(i=1;i<n-1;i++){
 if(ans[i]<=ans[i-1]&&ans[i]<=ans[i+1])
     count--;
}  

   cout<<count<<"\n";
    for(i=0;i<n;i++){
    cout<<ans[i]<<"  ";
}
    cout<<"\n";
}
}
