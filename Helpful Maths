#include<bits/stdc++.h>
using namespace std;
int main()
{
    string s;
    int i;
    cin>>s;
    int n=s.size();
    int l=(n/2)+1;
    int arr[l];
    int j=0;
    for(i=0;i<n;i++){
        if(s[i]=='1') {arr[j]=1;j++;}
        if(s[i]=='2') {arr[j]=2;j++;}
        if(s[i]=='3') {arr[j]=3;j++;}
        if(j>=l) break;
    }
    sort(arr,arr+l);
    for(i=0;i<l;i++){
            if(i==l-1) cout<<arr[i]<<'\n';
             else cout<<arr[i]<<"+";
    }
    return 0;
    }
